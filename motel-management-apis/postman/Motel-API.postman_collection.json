					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/motelApi/v1/motels?page=0&size=10&sort=motelName&direction=asc",
					"host": ["{{baseUrl}}"],
					"path": ["motelApi", "v1", "motels"],
					"query": [
						{"key": "page", "value": "0"},
						{"key": "size", "value": "10"},
						{"key": "sort", "value": "motelName"},
						{"key": "direction", "value": "asc"}
					]
				}
			},
			"response": []
