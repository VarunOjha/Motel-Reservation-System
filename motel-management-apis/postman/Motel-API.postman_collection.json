{
	"info": {
		"_postman_id": "motel-api-tests",
		"name": "Motel API - Complete Test Suite",
		"description": "Comprehensive test suite for Motel API with DTOs, validation, and Swagger",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "✅ 1. Create Motel (Valid)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201 Created\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test(\"Response has ApiResponse structure\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('status');",
							"    pm.expect(jsonData).to.have.property('data');",
							"    pm.expect(jsonData).to.have.property('message');",
							"});",
							"",
							"pm.test(\"Response contains MotelResponse DTO\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.data).to.have.property('motelId');",
							"    pm.expect(jsonData.data).to.have.property('motelName');",
							"    pm.expect(jsonData.data).to.have.property('status');",
							"});",
							"",
							"if (pm.response.code === 201) {",
							"    var jsonData = pm.response.json();",
							"    if (jsonData.data && jsonData.data.motelId) {",
							"        pm.collectionVariables.set(\"motelId\", jsonData.data.motelId);",
							"    }",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"motelChainId\": \"{{motelChainId}}\",\n  \"motelName\": \"Grand Plaza Hotel\",\n  \"status\": \"ACTIVE\",\n  \"pincode\": \"560001\",\n  \"state\": \"Karnataka\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/motelApi/v1/motels",
					"host": ["{{baseUrl}}"],
					"path": ["motelApi", "v1", "motels"]
				}
			},
			"response": []
		},
		{
			"name": "✅ 2. Get Motel by ID",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Motel data is correct\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.data.motelName).to.equal('Grand Plaza Hotel');",
							"    pm.expect(jsonData.data.status).to.equal('ACTIVE');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/motelApi/v1/motels/{{motelId}}",
					"host": ["{{baseUrl}}"],
					"path": ["motelApi", "v1", "motels", "{{motelId}}"]
				}
			},
			"response": []
		},
