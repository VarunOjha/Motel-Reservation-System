		{
			"name": "✅ 1. Create RoomCategory (Valid)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Test 1: Status code",
							"pm.test(\"Status code is 201 Created\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"// Test 2: Response structure",
							"pm.test(\"Response has ApiResponse structure\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('status');",
							"    pm.expect(jsonData).to.have.property('correlationId');",
							"    pm.expect(jsonData).to.have.property('timestamp');",
							"    pm.expect(jsonData).to.have.property('data');",
							"    pm.expect(jsonData).to.have.property('message');",
							"});",
							"",
							"// Test 3: DTO validation",
							"pm.test(\"Response contains RoomCategoryResponse DTO\", function () {",
							"    var jsonData = pm.response.json();",
							"    if (jsonData.data) {",
							"        pm.expect(jsonData.data).to.have.property('motelRoomCategoryId');",
							"        pm.expect(jsonData.data).to.have.property('roomCategoryName');",
							"        pm.expect(jsonData.data).to.have.property('motelChainId');",
							"        pm.expect(jsonData.data).to.have.property('motelId');",
							"        pm.expect(jsonData.data).to.have.property('status');",
							"        pm.expect(jsonData.data).to.have.property('createdAt');",
							"        pm.expect(jsonData.data).to.have.property('updatedAt');",
							"        pm.expect(jsonData.data).to.not.have.property('deletedAt');",
							"    }",
							"});",
							"",
							"// Test 4: Correlation ID exists",
							"pm.test(\"Correlation ID is present\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.correlationId).to.be.a('string');",
							"    pm.expect(jsonData.correlationId).to.have.lengthOf.above(0);",
							"});",
							"",
							"// Test 5: Success message",
							"pm.test(\"Success message is correct\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.message).to.equal('Room category created successfully');",
							"});",
							"",
							"// Save ID for later tests",
							"if (pm.response.code === 201) {",
							"    try {",
							"        var jsonData = pm.response.json();",
							"        if (jsonData.data && jsonData.data.motelRoomCategoryId) {",
							"            pm.collectionVariables.set(\"roomCategoryId\", jsonData.data.motelRoomCategoryId);",
							"            console.log(\"✅ Saved roomCategoryId: \" + jsonData.data.motelRoomCategoryId);",
							"        }",
							"    } catch(e) {",
							"        console.log(\"❌ Error saving ID: \" + e);",
							"    }",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
