		{
			"name": "✅ 6. Get Entity Count Statistics",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200 OK', function() {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"const jsonData = pm.response.json();",
							"",
							"pm.test('Response has count data', function() {",
							"    pm.expect(jsonData.data).to.have.property('postgresqlTables');",
							"    pm.expect(jsonData.data).to.have.property('totalPostgresqlRecords');",
							"    pm.expect(jsonData.data).to.have.property('note');",
							"});",
							"",
							"pm.test('PostgreSQL tables count exists', function() {",
							"    pm.expect(jsonData.data.postgresqlTables).to.have.property('motel_chains');",
							"    pm.expect(jsonData.data.postgresqlTables).to.have.property('motels');",
							"    pm.expect(jsonData.data.postgresqlTables).to.have.property('room_categories');",
							"    pm.expect(jsonData.data.postgresqlTables).to.have.property('rooms');",
							"});",
							"",
							"pm.test('Total count is sum of all tables', function() {",
							"    const tables = jsonData.data.postgresqlTables;",
							"    const expectedTotal = tables.motel_chains + tables.motels + tables.room_categories + tables.rooms;",
							"    pm.expect(jsonData.data.totalPostgresqlRecords).to.equal(expectedTotal);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/motelApi/v1/allMotels/count",
					"host": ["{{baseUrl}}"],
					"path": ["motelApi", "v1", "allMotels", "count"]
				}
			},
			"response": []
		}
