	"item": [
		{
			"name": "✅ 1. Get All Motels (Default Pagination)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200 OK', function() {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"const jsonData = pm.response.json();",
							"",
							"pm.test('Response has ApiResponse structure', function() {",
							"    pm.expect(jsonData).to.have.property('status');",
							"    pm.expect(jsonData).to.have.property('data');",
							"    pm.expect(jsonData).to.have.property('message');",
							"    pm.expect(jsonData).to.have.property('timestamp');",
							"    pm.expect(jsonData).to.have.property('correlationId');",
							"});",
							"",
							"pm.test('Response contains paginated data', function() {",
							"    pm.expect(jsonData.data).to.have.property('content');",
							"    pm.expect(jsonData.data).to.have.property('pagination');",
							"    pm.expect(jsonData.data.content).to.be.an('array');",
							"});",
							"",
							"pm.test('Pagination info is correct', function() {",
							"    pm.expect(jsonData.data.pagination.page).to.equal(0);",
							"    pm.expect(jsonData.data.pagination.size).to.be.at.least(0);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/motelApi/v1/allMotels",
					"host": ["{{baseUrl}}"],
					"path": ["motelApi", "v1", "allMotels"]
				}
			},
			"response": []
		},
