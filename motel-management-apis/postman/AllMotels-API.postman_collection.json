{
	"info": {
		"_postman_id": "allmotels-api-tests",
		"name": "AllMotels API - Complete Test Suite",
		"description": "Comprehensive tests for AllMotels read-only API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
