	"item": [
		{
			"name": "✅ 1. Create Room (Valid)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201 Created\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test(\"Response has ApiResponse structure\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('status');",
							"    pm.expect(jsonData).to.have.property('correlationId');",
							"    pm.expect(jsonData).to.have.property('timestamp');",
							"    pm.expect(jsonData).to.have.property('data');",
							"    pm.expect(jsonData).to.have.property('message');",
							"});",
							"",
							"pm.test(\"Response contains RoomResponse DTO\", function () {",
							"    var jsonData = pm.response.json();",
							"    if (jsonData.data) {",
							"        pm.expect(jsonData.data).to.have.property('roomId');",
							"        pm.expect(jsonData.data).to.have.property('roomNumber');",
							"        pm.expect(jsonData.data).to.have.property('motelChainId');",
							"        pm.expect(jsonData.data).to.have.property('motelId');",
							"        pm.expect(jsonData.data).to.have.property('status');",
							"        pm.expect(jsonData.data).to.have.property('createdAt');",
							"        pm.expect(jsonData.data).to.have.property('updatedAt');",
							"        pm.expect(jsonData.data).to.not.have.property('deletedAt');",
							"    }",
							"});",
							"",
							"pm.test(\"Success message is correct\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.message).to.equal('Room created successfully');",
							"});",
							"",
							"if (pm.response.code === 201) {",
							"    try {",
							"        var jsonData = pm.response.json();",
							"        if (jsonData.data && jsonData.data.roomId) {",
							"            pm.collectionVariables.set(\"roomId\", jsonData.data.roomId);",
							"            console.log(\"✅ Saved roomId: \" + jsonData.data.roomId);",
							"        }",
							"    } catch(e) {",
							"        console.log(\"❌ Error saving ID: \" + e);",
							"    }",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"motelChainId\": \"{{motelChainId}}\",\n  \"motelId\": \"{{motelId}}\",\n  \"motelRoomCategoryId\": \"{{roomCategoryId}}\",\n  \"roomNumber\": \"101\",\n  \"floor\": \"1\",\n  \"status\": \"AVAILABLE\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/motelApi/v1/motelRooms",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"motelApi",
						"v1",
						"motelRooms"
					]
				}
			},
			"response": []
		},
