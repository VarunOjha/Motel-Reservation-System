			"name": "✅ 3. Get All Rooms (Paginated)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response has pagination structure\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.data).to.have.property('content');",
							"    pm.expect(jsonData.data).to.have.property('pagination');",
							"    pm.expect(jsonData.data.content).to.be.an('array');",
							"});",
							"",
							"pm.test(\"Pagination info is correct\", function () {",
							"    var jsonData = pm.response.json();",
							"    var pagination = jsonData.data.pagination;",
							"    pm.expect(pagination).to.have.property('page');",
							"    pm.expect(pagination).to.have.property('size');",
							"    pm.expect(pagination).to.have.property('total_elements');",
							"    pm.expect(pagination).to.have.property('total_pages');",
							"    pm.expect(pagination.page).to.equal(0);",
							"    pm.expect(pagination.size).to.equal(10);",
							"});",
							"",
							"pm.test(\"Content array has at least 1 item\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.data.content.length).to.be.above(0);",
							"});"
